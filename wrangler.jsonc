{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitness-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-05-20",
  "observability": { "enabled": true },
  // Created by: wrangler kv namespace create TOKENS
  // Paste the printed id below.
  "kv_namespaces": [
    { "binding": "TOKENS", "id": "PASTE_KV_ID_HERE" }
  ]
  // Secrets (set with `wrangler secret put NAME`, not here):
  //   PUSH_KEY, WATCH_KEY
}
